<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dailystock.moomoo-sync</string>

    <!-- Legacy writer is intentionally paused and exits without opening a
         trade context or writing Journal data.  MOOMOO_TRADE_ENV only denotes
         a historical-query scope; it must never enable unlock or execution. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT_DIR__/scripts/run_with_rotating_logs.py</string>
        <string>--stdout-log</string>
        <string>__PROJECT_DIR__/logs/launchagent.moomoo-sync.out.log</string>
        <string>--stderr-log</string>
        <string>__PROJECT_DIR__/logs/launchagent.moomoo-sync.err.log</string>
        <string>--max-bytes</string>
        <string>10485760</string>
        <string>--backup-count</string>
        <string>3</string>
        <string>--</string>
        <string>__PYTHON__</string>
        <string>__PROJECT_DIR__/scripts/sync_moomoo_live.py</string>
        <string>--days</string>
        <string>2</string>
        <string>-v</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- Run on login + every 900 seconds (15 min) -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/dev/null</string>

    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
